[Unit]
Description=cybershorts Telegram review bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cybershorts
Group=cybershorts
WorkingDirectory=/opt/cybershorts
ExecStart=/opt/cybershorts/.venv/bin/python scripts/bot.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
