# Copy to .env and fill in. Never commit .env.

# OpenRouter API key for story picking and script writing. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Pixabay API key for background clips (default provider). Log in, then copy it from https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Optional: Pexels key, only if broll.provider is pexels. https://www.pexels.com/api/
PEXELS_API_KEY=

# Telegram bot token from @BotFather (/newbot). Used for draft review.
TELEGRAM_BOT_TOKEN=

# Your personal Telegram chat ID. Message your bot, then read it from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# TikTok developer app client key and secret. https://developers.tiktok.com/ (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# OAuth redirect URI registered in the TikTok app. Hosted from docs/callback.html via GitHub Pages.
TIKTOK_REDIRECT_URI=https://YOURGITHUBUSER.github.io/cybershorts/callback.html

# Optional. Uptime Kuma push monitor URL, pinged after each scheduled draft run. Leave blank to disable.
HEALTHCHECK_URL=

# Optional. Only set if the app directory is not the parent of this package.
# APP_DIR=/opt/cybershorts

# Optional: ElevenLabs API key for voice.engine: elevenlabs. elevenlabs.io > Developers > API Keys
# (give it Text to Speech + User read access)
ELEVENLABS_API_KEY=
